{
  "uid": "runedrive-observability",
  "title": "RuneDrive — спостережність (ЛР-7)",
  "tags": ["runedrive", "gitops", "monitoring"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "15s",
  "time": { "from": "now-30m", "to": "now" },
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "DS_PROM",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "RPS (усі інстанси)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "mode": "thresholds" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
          "expr": "sum(rate(http_requests_total{job=\"runedrive-runedrive-api\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Частка 5xx",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
          "expr": "100 * sum(rate(http_requests_total{job=\"runedrive-runedrive-api\",status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_requests_total{job=\"runedrive-runedrive-api\"}[$__rate_interval])), 0.001)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p95 відповіді",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 3 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=\"runedrive-runedrive-api\"}[$__rate_interval])))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Живі інстанси",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
          "expr": "count(up{job=\"runedrive-runedrive-api\"} == 1)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "RPS за ендпоінтами",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 12, "showPoints": "never" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
          "expr": "sum by (handler) (rate(http_requests_total{job=\"runedrive-runedrive-api\"}[$__rate_interval]))",
          "legendFormat": "{{handler}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "p50 / p95 / p99, секунди",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 0, "showPoints": "never" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=\"runedrive-runedrive-api\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=\"runedrive-runedrive-api\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=\"runedrive-runedrive-api\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Частка 5xx за інстансами, %",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": { "unit": "percent", "custom": { "fillOpacity": 15, "showPoints": "never" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
          "expr": "100 * sum by (pod) (rate(http_requests_total{job=\"runedrive-runedrive-api\",status=~\"5..\"}[$__rate_interval])) / clamp_min(sum by (pod) (rate(http_requests_total{job=\"runedrive-runedrive-api\"}[$__rate_interval])), 0.001)",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "RPS за інстансами (видно canary)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
          "expr": "sum by (pod) (rate(http_requests_total{job=\"runedrive-runedrive-api\"}[$__rate_interval]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Ін'єкційні 5xx (fault_injected = true)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 23 },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{namespace=\"runedrive\"} | json | fault_injected=\"true\"",
          "maxLines": 100
        }
      ]
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Потокові логи застосунку (JSON)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 23 },
      "options": {
        "showTime": true,
        "wrapLogMessage": false,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{namespace=\"runedrive\", app=\"runedrive\"} | json | level=\"error\"",
          "maxLines": 100
        }
      ]
    }
  ]
}
